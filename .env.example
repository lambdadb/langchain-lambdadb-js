# LambdaDB Configuration
# Copy this file to .env and fill in your actual values

# Required: LambdaDB project API key
LAMBDADB_PROJECT_API_KEY=your_project_api_key_here

# Required: LambdaDB base URL (e.g. https://api.lambdadb.ai)
LAMBDADB_BASE_URL=your_base_url_here

# Required: LambdaDB project name (path segment under /projects/)
LAMBDADB_PROJECT_NAME=your_project_name_here

# Optional: OpenAI API key for embedding examples (if using real embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# Run integration tests (loads .env automatically):
#   npm run test:integration
